# === LeanIX Mode ===
LEANIX_MODE=mock
LEANIX_BASE_URL=http://localhost:4000
LEANIX_SUBDOMAIN=mock

# === Authentication ===
LEANIX_API_TOKEN=dev-token-12345
LEANIX_API_TOKEN_SECRET=dev-secret-67890
LEANIX_WORKSPACE=development
JWT_SECRET=change-me-in-production

# === Database ===
# Local Docker/native: postgresql://leanix:leanix@localhost:5432/leanix_mock?schema=public
# Managed/cloud (Neon, etc.): postgresql://user:pass@host/db?sslmode=require
# If your provider's pooled endpoint is PgBouncer-based (Neon's "-pooler" host), add
# &pgbouncer=true so Prisma disables prepared-statement caching, which PgBouncer's
# transaction-pooling mode doesn't support.
DATABASE_URL=postgresql://leanix:leanix@localhost:5432/leanix_mock?schema=public

# If DATABASE_URL points at a PgBouncer/pooled endpoint, `prisma migrate` needs a DIRECT
# (non-pooled) connection instead — pooled connections were found (2026-08-31, see
# docs/BUILD_STATUS.md §5) to apply migration DDL successfully but silently fail to record it in
# `_prisma_migrations`, and to be prone to advisory-lock deadlocks across separate CLI
# invocations. Same host/credentials as DATABASE_URL, just without "-pooler" in the hostname and
# without &pgbouncer=true. Only used for `prisma migrate ...` commands, never by the running app.
# Local/non-pooled setups can leave this unset — DATABASE_URL is already direct.
DIRECT_DATABASE_URL=postgresql://leanix:leanix@localhost:5432/leanix_mock?schema=public

# === Redis ===
# Local Docker: redis://localhost:6379/0
# Managed/cloud (Upstash, Redis Cloud, etc.): rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379/0

# === Server ===
PORT=4000
NODE_ENV=development

# === Mock Features ===
MOCK_RATE_LIMIT_ENABLED=true
MOCK_WEBHOOK_DELIVERY_ENABLED=true
MOCK_AUTO_DELETE_ENABLED=true
MOCK_TRASH_BIN_RETENTION_DAYS=90

# === Rate Limits ===
RATE_LIMIT_USER_PER_MINUTE=1800
RATE_LIMIT_WORKSPACE_PER_MINUTE=1200

# === CORS ===
# '*' allows any origin (fine for local dev). In a shared/public deployment, set this to your
# consuming application's real origin(s), comma-separated.
CORS_ORIGIN=*
