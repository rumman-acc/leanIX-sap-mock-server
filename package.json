{
  "name": "leanix-dev-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "LeanIX-compatible mock server for zero-cost development",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "lint": "npm run lint --workspace=apps/api",
    "prisma:generate": "npm run generate --workspace=packages/prisma",
    "prisma:migrate": "npm run migrate --workspace=packages/prisma",
    "prisma:seed": "npm run seed --workspace=packages/prisma"
  }
}
