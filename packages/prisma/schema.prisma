// packages/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used only by `prisma migrate`/`prisma db` commands, never by the running app (PrismaClient
  // always uses `url`). Needed because DATABASE_URL may point at a PgBouncer-pooled endpoint,
  // which migration commands can't reliably use — see docs/BUILD_STATUS.md §5 and .env.example.
  // Must always be set (Prisma requires it once `directUrl` is present in the schema at all) —
  // for a non-pooled local Postgres, just set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// --- Meta Model --------------------------------------------

model FactSheetType {
  id            String   @id @default(cuid())
  // Real LeanIX's meta model is per-workspace (every workspace can define its own custom fields
  // and even its own types) — see LeanIX_Mock_Server_Scope.md §2.1. Previously this mock had one
  // implicit global meta model; scoping it is what makes a genuine second workspace possible.
  workspaceId   String   @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  technicalKey  String   @map("technical_key")
  label         String
  description   String?
  icon          String?
  color         String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  attributes    Attribute[]
  factSheets    FactSheet[]
  relationsAsSource RelationType[] @relation("SourceType")
  relationsAsTarget RelationType[] @relation("TargetType")

  @@unique([workspaceId, technicalKey])
  @@map("fact_sheet_types")
}

model Attribute {
  id            String   @id @default(cuid())
  technicalKey  String   @map("technical_key")
  label         String
  description   String?
  dataType      String   @map("data_type")
  factSheetTypeId String @map("fact_sheet_type_id")
  factSheetType   FactSheetType @relation(fields: [factSheetTypeId], references: [id])
  mandatory     Boolean  @default(false)
  hidden        Boolean  @default(false)
  readOnly      Boolean  @default(false) @map("read_only")

  allowedValues AllowedValue[]
  attributeValues AttributeValue[]

  @@unique([factSheetTypeId, technicalKey])
  @@map("attributes")
}

model AllowedValue {
  id          String   @id @default(cuid())
  value       String
  label       String
  color       String?
  attributeId String   @map("attribute_id")
  attribute   Attribute @relation(fields: [attributeId], references: [id])

  @@map("allowed_values")
}

model RelationType {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  technicalKey  String   @map("technical_key")
  label         String
  description   String?
  sourceTypeId  String   @map("source_type_id")
  sourceType    FactSheetType @relation("SourceType", fields: [sourceTypeId], references: [id])
  targetTypeId  String   @map("target_type_id")
  targetType    FactSheetType @relation("TargetType", fields: [targetTypeId], references: [id])
  cardinality   String   @default("MANY_TO_MANY")
  mandatory     Boolean  @default(false)

  relations     Relation[]

  @@unique([workspaceId, sourceTypeId, targetTypeId, technicalKey])
  @@map("relation_types")
}

// --- Fact Sheets -------------------------------------------

model FactSheet {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  typeId        String   @map("type_id")
  type          FactSheetType @relation(fields: [typeId], references: [id])
  name          String
  description   String?
  externalId    String?  @map("external_id")
  displayName   String   @map("display_name")

  lifecycle     Json?

  qualitySeal   String   @default("BROKEN") @map("quality_seal")
  // Optimistic-concurrency revision counter — real LeanIX confirmed to have this in
  // updateFactSheet's signature, see docs/RESEARCH_LEANIX_REAL_API.md §6.
  rev           Int      @default(1)
  completion    Float    @default(0.0)

  status        String   @default("ACTIVE")
  trashBin      Boolean  @default(false) @map("trash_bin")
  archivedAt    DateTime? @map("archived_at")
  autoDeleteAt  DateTime? @map("auto_delete_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String   @map("created_by")
  updatedBy     String   @map("updated_by")

  attributes    AttributeValue[]
  tags          TagAssignment[]
  subscriptions Subscription[]
  comments      Comment[]
  todos         Todo[]

  sourceRelations Relation[] @relation("SourceFactSheet")
  targetRelations Relation[] @relation("TargetFactSheet")

  syncMappings  SyncMapping[]
  syncLogs      SyncLog[]

  @@index([typeId])
  @@index([externalId])
  @@index([status])
  @@index([trashBin])
  @@index([workspaceId])
  @@map("fact_sheets")
}

// --- Comments & To-Dos ---------------------------------------

model Comment {
  id            String   @id @default(cuid())
  factSheetId   String   @map("fact_sheet_id")
  factSheet     FactSheet @relation(fields: [factSheetId], references: [id], onDelete: Cascade)
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  message       String

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([factSheetId])
  @@map("comments")
}

model Todo {
  id            String   @id @default(cuid())
  title         String
  description   String?
  status        String   @default("OPEN")
  factSheetId   String?  @map("fact_sheet_id")
  factSheet     FactSheet? @relation(fields: [factSheetId], references: [id], onDelete: Cascade)
  assigneeId    String?  @map("assignee_id")
  assignee      User?    @relation(fields: [assigneeId], references: [id])
  dueDate       DateTime? @map("due_date")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([factSheetId])
  @@index([assigneeId])
  @@index([status])
  @@map("todos")
}

model AttributeValue {
  id            String   @id @default(cuid())
  factSheetId   String   @map("fact_sheet_id")
  factSheet     FactSheet @relation(fields: [factSheetId], references: [id], onDelete: Cascade)
  attributeId   String   @map("attribute_id")
  attribute     Attribute @relation(fields: [attributeId], references: [id])
  value         Json

  @@unique([factSheetId, attributeId])
  @@map("attribute_values")
}

model Relation {
  id            String   @id @default(cuid())
  relationTypeId String  @map("relation_type_id")
  relationType   RelationType @relation(fields: [relationTypeId], references: [id])

  sourceId      String   @map("source_id")
  source        FactSheet @relation("SourceFactSheet", fields: [sourceId], references: [id])
  targetId      String   @map("target_id")
  target        FactSheet @relation("TargetFactSheet", fields: [targetId], references: [id])

  description   String?

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([relationTypeId, sourceId, targetId])
  @@map("relations")
}

// --- Tags --------------------------------------------------

model TagGroup {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  name          String
  description   String?
  color         String?
  tags          Tag[]

  @@unique([workspaceId, name])
  @@map("tag_groups")
}

model Tag {
  id            String   @id @default(cuid())
  name          String
  groupId       String   @map("group_id")
  group         TagGroup @relation(fields: [groupId], references: [id])
  color         String?

  assignments   TagAssignment[]

  @@unique([groupId, name])
  @@map("tags")
}

model TagAssignment {
  id            String   @id @default(cuid())
  factSheetId   String   @map("fact_sheet_id")
  factSheet     FactSheet @relation(fields: [factSheetId], references: [id], onDelete: Cascade)
  tagId         String   @map("tag_id")
  tag           Tag @relation(fields: [tagId], references: [id])

  @@unique([factSheetId, tagId])
  @@map("tag_assignments")
}

// --- Subscriptions -----------------------------------------

model Subscription {
  id            String   @id @default(cuid())
  factSheetId   String   @map("fact_sheet_id")
  factSheet     FactSheet @relation(fields: [factSheetId], references: [id], onDelete: Cascade)
  userId        String   @map("user_id")
  userName      String   @map("user_name")
  userEmail     String   @map("user_email")
  type          String
  roles         String[]

  @@unique([factSheetId, userId, type])
  @@map("subscriptions")
}

// --- Trash Bin ---------------------------------------------

model TrashBinEntry {
  id            String   @id @default(cuid())
  factSheetId   String   @unique @map("fact_sheet_id")
  factSheetType String   @map("fact_sheet_type")
  name          String
  externalId    String?  @map("external_id")
  archivedAt    DateTime @map("archived_at")
  autoDeleteAt  DateTime @map("auto_delete_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([autoDeleteAt])
  @@map("trash_bin")
}

// --- Sync & Integration ------------------------------------

model IntegrationConfiguration {
  id              String   @id @default(cuid())
  name            String
  connectorType   String   @map("connector_type")
  connectorId     String   @map("connector_id")
  connectorVersion String  @map("connector_version")
  processingDirection String @map("processing_direction")
  processingMode  String   @map("processing_mode")
  processors      Json
  status          String   @default("ACTIVE")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([connectorId, connectorType])
  @@map("integration_configurations")
}

model SyncMapping {
  id              String   @id @default(cuid())
  sourceSystem    String   @map("source_system")
  sourceRecordId  String   @map("source_record_id")
  factSheetId     String   @map("fact_sheet_id")
  factSheet       FactSheet @relation(fields: [factSheetId], references: [id])
  factSheetType   String   @map("fact_sheet_type")
  lastSyncedAt    DateTime @map("last_synced_at")
  syncHash        String   @map("sync_hash")
  status          String   @default("ACTIVE")

  @@unique([sourceSystem, sourceRecordId])
  @@index([factSheetId])
  @@map("sync_mappings")
}

model SyncRun {
  id              String   @id @default(cuid())
  connectorType   String   @map("connector_type")
  connectorId     String   @map("connector_id")
  connectorVersion String  @map("connector_version")
  processingDirection String @default("inbound") @map("processing_direction")
  processingMode  String   @default("partial") @map("processing_mode")
  description     String?
  status          String   @default("CREATED")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  errorCount      Int      @default(0) @map("error_count")
  warningCount    Int      @default(0) @map("warning_count")
  processedCount  Int      @default(0) @map("processed_count")
  createdCount    Int      @default(0) @map("created_count")
  updatedCount    Int      @default(0) @map("updated_count")
  deletedCount    Int      @default(0) @map("deleted_count")

  logs            SyncLog[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("sync_runs")
}

model SyncLog {
  id              String   @id @default(cuid())
  syncRunId       String   @map("sync_run_id")
  syncRun         SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  factSheetId     String?  @map("fact_sheet_id")
  factSheet       FactSheet? @relation(fields: [factSheetId], references: [id])
  level           String
  message         String
  details         Json?
  sourceRecordId  String?  @map("source_record_id")

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([syncRunId])
  @@index([level])
  @@map("sync_logs")
}

// --- Webhooks ----------------------------------------------

// Field names/shape match real LeanIX's webhook subscription API exactly (source: the real
// terraform-provider-leanix client, see docs/RESEARCH_LEANIX_REAL_API.md §2) — NOT the
// url/events/secret shape the original spec assumed. `events`/`secret` below are a documented
// mock-only convenience extension (real LeanIX ties triggers to a separately configured
// "Automation" this mock doesn't implement, and authenticates deliveries via
// `authorizationHeader`, not payload signing).
model Webhook {
  id                  String   @id @default(cuid())
  identifier          String
  targetUrl           String   @map("target_url")
  targetMethod        String   @default("POST") @map("target_method")
  authorizationHeader String?  @map("authorization_header")
  callback            String?
  tagSets             Json?    @map("tag_sets")
  workspaceConstraint String   @default("ANY") @map("workspace_constraint")
  payloadMode         String   @default("DEFAULT") @map("payload_mode")
  deliveryType        String   @default("PUSH") @map("delivery_type")
  ignoreError         Boolean  @default(true) @map("ignore_error")
  active              Boolean  @default(true)
  workspaceId         String   @map("workspace_id")

  // --- mock-only convenience (not part of real LeanIX's contract) ---
  events              String[] @default([])
  secret              String?

  deliveries      WebhookDelivery[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("webhooks")
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  webhookId       String   @map("webhook_id")
  webhook         Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType       String   @map("event_type")
  payload         Json
  responseStatus  Int?     @map("response_status")
  responseBody    String?  @map("response_body")
  success         Boolean  @default(false)
  errorMessage    String?  @map("error_message")
  attemptCount    Int      @default(1) @map("attempt_count")
  nextRetryAt     DateTime? @map("next_retry_at")

  createdAt       DateTime @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@index([webhookId])
  @@index([success])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

// --- Surveys -------------------------------------------------

model SurveyDefinition {
  id            String   @id @default(cuid())
  name          String
  description   String?
  // Which fact sheet type this survey targets (e.g. "Application" for an owner-confirmation
  // survey) — real LeanIX surveys are scoped to a fact sheet type, per capability map §1.2.
  factSheetType String?  @map("fact_sheet_type")
  questions     Json
  status        String   @default("ACTIVE")

  runs          SurveyRun[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("survey_definitions")
}

model SurveyRun {
  id              String   @id @default(cuid())
  definitionId    String   @map("definition_id")
  definition      SurveyDefinition @relation(fields: [definitionId], references: [id])
  status          String   @default("RUNNING")

  invitations     SurveyInvitation[]

  createdAt       DateTime @default(now()) @map("created_at")
  closedAt        DateTime? @map("closed_at")

  @@index([definitionId])
  @@map("survey_runs")
}

model SurveyInvitation {
  id            String   @id @default(cuid())
  runId         String   @map("run_id")
  run           SurveyRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  factSheetId   String?  @map("fact_sheet_id")
  status        String   @default("PENDING")

  response      SurveyResponse?

  invitedAt     DateTime @default(now()) @map("invited_at")

  @@index([runId])
  @@map("survey_invitations")
}

model SurveyResponse {
  id            String   @id @default(cuid())
  invitationId  String   @unique @map("invitation_id")
  invitation    SurveyInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  answers       Json

  submittedAt   DateTime @default(now()) @map("submitted_at")

  @@map("survey_responses")
}

// --- Users & Workspace -------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          String   @default("MEMBER")
  workspaceId   String   @map("workspace_id")
  apiToken      String?  @unique @map("api_token")
  apiTokenSecret String? @map("api_token_secret")

  comments      Comment[]
  assignedTodos Todo[]
  surveyInvitations SurveyInvitation[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Workspace {
  id            String   @id @default(cuid())
  name          String   @unique
  displayName   String   @map("display_name")
  description   String?

  factSheetTypes FactSheetType[]
  relationTypes  RelationType[]
  factSheets     FactSheet[]
  tagGroups      TagGroup[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("workspaces")
}
